# ── Option A: Amadeus for Developers ────────────────────────────────────────
# Free test environment: ~2,000 requests/month
# Sign up (5 min, no credit card): https://developers.amadeus.com/register
# After signing up: My Apps → Create new app → copy Client ID & Secret
#
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
#
# Set to "production" to use live data (requires contract; test env is fine for dev)
# AMADEUS_ENV=test


# ── Option B: SerpAPI (Google Flights) ───────────────────────────────────────
# Real Google Flights data, 250 free searches/month
# Sign up: https://serpapi.com/users/sign_up  → Dashboard → API Key
#
# SERPAPI_KEY=your_serpapi_key_here


# ── Priority ──────────────────────────────────────────────────────────────────
# If both are set, Amadeus is used first.
# If neither is set, the app runs in demo mode with realistic fake data.
